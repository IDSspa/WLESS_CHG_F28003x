# BOOST+HFC+BUCK closed loop, governor bootstrap: VEHICLE / COM25
# Eseguire per fasi interleaved con BOOST_HFC_BUCK_BOOT_GOVERNOR_STATION.wcx.
# Non inviare comandi UART dopo VIN ON. I valori sono volatili dopo power cycle.

# FASE V1 - configurazione a VIN OFF, DCLINK scarico, WPT fermo
SMVBUS=5
@200
SMICOIL=100
@200
SMBOOTMODE=1
@200
SMBOOTSRC=23
@200
SMBA=10
@200
SMBH=14
@200
SMBOOTDUTY=100
@200
SMBHD=150
@200
SMBHH=600
@200
WPTSRC=20000
@200
WPTLOAD=20000
@200
WPTIMAX=5000
@200
WPTPLIMINIT=15
@200
WPTHFCLIM=400
@200
WPTHFCPH=470
@200
WPTCLAMP=0
@200
WPTHFCRAMP=0
@200
UE=0
@200
UH=1
@200
UW=12000
@200
UR=24
@200
UY=50
@200
UA=10000
@200
UC=10000
@200
UN=22
@200
UD=950
@200
US=500
@200
UF=1

# FASE V2 - dopo che STATION ha completato la propria configurazione
MANUAL
@500
SOURCE
# Fermarsi: attendere VEHICLE=INIT_SOURCE e STATION=INIT_LOAD.

# FASE V3 - eseguire solo dopo INITOK sulla STATION e STATION=WAIT_SOURCE
INITOK
# Fermarsi: attendere VEHICLE=PRECHARGE_SOURCE e radio OK.
# Con il bootstrap attivo la STATION resta intenzionalmente WAIT_SOURCE fino
# alla pubblicazione remota WPTBOOT, che avviene dopo VIN ON e consenso VDC SOURCE.

# FASE V4 - eseguire solo dopo WPT=1 sulla STATION
WPT=1
# Fermarsi: VIN ON; attendere il run pianificato senza UART.

# FASE V5 - chiusura, dopo il run e prima di VIN OFF
STOP
