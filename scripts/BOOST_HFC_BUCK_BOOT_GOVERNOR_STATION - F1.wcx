@200
SMBOOTLOAD=15
@200
WPTSRC=20000
@200
WPTLOAD=20000
@200
WPTIMAX=5000
@200
UE=0
@200
UH=2
@200
UP=0
@200
UV=20000
@200
UA=4000
@200
UD=950
@200
US=2000
@200
UX=30000
@200
UC=6000
@200
UN=22
@200
